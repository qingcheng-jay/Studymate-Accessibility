# 复制本文件为 .env 并填入真实 Key。所有 API Key 只允许放在这里，禁止硬编码。

# ===== LLM API（阶段 3 接入，OpenAI 兼容接口均可：DeepSeek / 通义千问 / Moonshot / MiMo 等）=====
LLM_API_KEY=sk-your-api-key
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# ===== Embedding API（通义千问 DashScope，text-embedding-v1）=====
DASHSCOPE_API_KEY=sk-your-dashscope-key
